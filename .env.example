# Required for tailoring, gap analysis and cover letters. Without it the pipeline
# still runs end to end in offline mode (selection and reordering, no rewriting).
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5-5. Cheaper: claude-sonnet-5-5.
RT_MODEL=claude-opus-5-5

# Optional. Override every step's effort level: low, medium, high, xhigh, max.
# Lower is cheaper and faster. Unset lets each step choose.
# RT_EFFORT=medium

# Optional. Use profiles/<name>/ by default (see "Profiles" in the README).
# RT_PROFILE=jane

# Optional. Set to 0 to stop retrying a safety decline on another model.
# RT_FALLBACKS=1
